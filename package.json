{
  "name": "yamachika-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "dev": "node tools/preview.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:publish": "node tools/publish-browser-check.mjs",
    "check:worker": "npm run build && node --check dist/_worker.js",
    "deploy": "npm run build && wrangler pages deploy dist --project-name website --branch main"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "wrangler": "^4.0.0"
  }
}
